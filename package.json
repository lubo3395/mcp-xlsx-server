{
  "name": "mcp-xlsx-server",
  "version": "1.0.0",
  "description": "MCP server for Excel file read/write operations using SheetJS (xlsx)",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "xlsx",
    "excel",
    "sheetjs",
    "claude",
    "mcp-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lubo3395/mcp-xlsx-server.git"
  },
  "bugs": {
    "url": "https://github.com/lubo3395/mcp-xlsx-server/issues"
  },
  "homepage": "https://github.com/lubo3395/mcp-xlsx-server#readme",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
